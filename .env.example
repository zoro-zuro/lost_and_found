# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/?appName=Cluster0

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=30d

# Staff Registration
STAFF_REGISTER_SECRET=your_staff_registration_secret

# Mail Configuration
MAIL_PROVIDER=gmail
MAIL_USER=your_email@gmail.com
MAIL_APP_PASSWORD=your_app_specific_password
MAIL_FROM_NAME=LostAndFound
NOTIFICATION_MODE=email

# Security Notes:
# 1. Never commit this file to version control
# 2. Use strong, unique secrets
# 3. Rotate secrets regularly
# 4. Use app-specific passwords, not personal ones
# 5. Enable 2FA on email accounts
