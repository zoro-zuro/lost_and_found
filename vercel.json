{
  "version": 2,
  "builds": [
    {"src": "server/src/index.js", "use": "@vercel/node", "config": {"maxDuration": 10}},
    {"src": "client/package.json", "use": "@vercel/static-build", "config": {"distDir": "dist"}}
  ],
  "routes": [
    {"src": "/api/(.*)", "dest": "/server/src/index.js"},
    {"src": "/uploads/(.*)", "dest": "/server/uploads/$1"},
    {"src": "/assets/(.*)", "dest": "/client/assets/$1"},
    {"src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2)$)", "dest": "/client/$1"},
    {"src": "/vite.svg", "dest": "/client/vite.svg"},
    {"src": "/(.*)", "dest": "/client/index.html"}
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2)$)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "env": {"NODE_ENV": "production"}
}